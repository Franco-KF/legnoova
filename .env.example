# --- Database ---
MONGODB_URI=

# --- Auth (NextAuth / Google OAuth) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# CSRF double-submit secret — generate with: openssl rand -hex 32
CSRF_SECRET=
NEXTAUTH_URL=https://legnoova.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Gemini AI (chart analysis) ---
GEMINI_API_KEY=

# --- Email (Mailtrap) ---
MAILTRAP_API_TOKEN=
EMAIL_FROM_EMAIL=
EMAIL_FROM_NAME=

# --- App URL (used in emails and reset links) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Paddle Billing ---
# Server-side API key (secret) — from Paddle > Developer > Authentication
PADDLE_API_KEY=
# Webhook signing secret (secret) — from Paddle > Developer > Notifications
# Webhook URL to register in Paddle: https://legnoova.com/api/billing/webhook
PADDLE_WEBHOOK_SECRET=
# Client-side token (public) — from Paddle > Developer > Authentication
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# "sandbox" while testing, "production" when live
NEXT_PUBLIC_PADDLE_ENV=sandbox
# Price IDs (pri_...) — one per plan, from Paddle > Catalog > Products
NEXT_PUBLIC_PADDLE_PRICE_ANALYZE=
NEXT_PUBLIC_PADDLE_PRICE_BROKER=

# --- Testing ---
# Enables the test-only plan activation endpoint in PRODUCTION builds.
# Leave unset in production. In development it is enabled automatically.
# PAYMENTS_TEST_MODE=false

# --- Card encryption at rest (AES-256-GCM) ---
# 32-byte key as 64 hex characters. Generate with: openssl rand -hex 32
# WARNING: changing this key makes previously stored card numbers unreadable.
CARD_ENCRYPTION_KEY=

# --- Admin panel ---
# Admin login is separate from end-user accounts. Prefer ADMIN_PASSWORD_HASH
# (bcrypt). Generate a hash with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Fallback plaintext password (not recommended). Used only if no hash is set.
# ADMIN_PASSWORD=
